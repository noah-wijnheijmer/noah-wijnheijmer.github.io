# Always serve the site as https://wijnheijmer.com (no http, no www)
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://wijnheijmer.com/$1 [R=301,L]

# Never serve deployment bookkeeping files (git folder, FTP upload state file)
RedirectMatch 404 /\.git
RedirectMatch 404 /\.ftp-deploy-sync-state\.json$
